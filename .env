# ============================================================
# AIPeT — ENVIRONMENT VARIABLES
# Copy this file to .env, fill in real values, NEVER commit .env
# ============================================================

# --- Database (PostgreSQL) ---
# Works with any Postgres host: Supabase, Railway, Neon, or your own server.
#
# If using Supabase: do NOT use the "Direct connection" string shown by
# default (db.<ref>.supabase.co:5432) — it's IPv6-only on most projects
# and will fail with Prisma error P1001 ("Can't reach database server")
# on any network without IPv6, which is most home/office networks. Use
# the POOLED connection strings instead:
#   Dashboard -> Project Settings -> Database -> Connection string
#   -> "Connection pooling" tab (NOT "Direct connection")
#
# IMPORTANT: copy each string EXACTLY as shown on the dashboard — do NOT
# hand-type or guess the region part (the "aws-0-xx-xxxx-1" bit below is
# a PLACEHOLDER, not a real region). Supabase's pooler is deployed
# per-region; a wrong/guessed region gives a different, confusing error:
# "FATAL: tenant or user not found" — that's Supavisor (the pooler)
# looking for your project in the wrong region's pooler, not a real auth
# problem. Only the [password] part is yours to fill in; everything else
# in the host should be pasted straight from the dashboard.
#
# DATABASE_URL = "Transaction" mode pooler, port 6543 — used for normal
# app queries at runtime. Must include ?pgbouncer=true.
# DATABASE_URL = "Transaction" mode pooler, port 6543 — used for normal
# app queries at runtime. Must include ?pgbouncer=true. The trailing
# &connection_limit=1 matters too: PgBouncer already pools connections on
# Supabase's side, and Prisma opening its OWN internal pool on top
# (default size scales with CPU cores) can exhaust the pooler's limited
# connection slots on the free tier — that's a common cause of
# intermittent "Can't reach database server" errors that come and go
# under normal use, not a real outage.


#
# DIRECT_URL = "Session" mode pooler, port 5432 — used only for
# `npm run db:push` / `db:migrate`, which need prepared-statement support
# that the transaction pooler above doesn't provide. Same host, different
# port, no ?pgbouncer=true.

# ----------------------------------------------------------------------------------:
DATABASE_URL="postgresql://postgres.*****:*****@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.*****:*****@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

#
# Using a non-Supabase Postgres host instead (Railway, Neon, self-hosted)?
# Just set DATABASE_URL and DIRECT_URL to the same normal connection
# string — the pooler split above is a Supabase-specific detail.




# --- Auth / Sessions ---
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------:
JWT_SECRET="*******="




# --- Site ---
#NEXT_PUBLIC_SITE_URL="https://aipet.dz"
# ---------------------------------------------------------------------------:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AIPeT — AI Pedagogical Tutor"



# --- Contact info shown on the site ---
CONTACT_EMAIL="contact@aipet.dz"

# --- File storage (submission photos) ---
# Ships working out of the box with local disk storage (see
# src/lib/storage.ts). Before going to production on Vercel, switch to
# object storage — Vercel's filesystem isn't persistent/shared across
# instances. Any S3-compatible bucket works (Supabase Storage,
# Cloudflare R2, AWS S3); these vars are for that upgrade.

# ----------------------------------------------------------------------------------
STORAGE_ENDPOINT="https://xxx.supabase.co/storage/v1"
STORAGE_BUCKET="aipet-media"
STORAGE_ACCESS_KEY="xxxxxxxx"
STORAGE_SECRET_KEY="xxxxxxxx"




# ----------------------------------------------------------------------------------:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="mostefa.kara.alg@gmail.com"
SMTP_PASSWORD="*****"
SMTP_FROM="AIPeT <mostefa.kara.alg@gmail.com>"




# --- Rate limiting (Upstash Redis — free tier is enough at launch) ---
# -----------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# --- Payments: Chargily Pay (Algeria — EDAHABIA / CIB / BaridiMob) ---
# Get merchant keys at https://pay.chargily.net (sign up, then Developers
# tab). Subscriptions won't work without these — /aipet/subscribe/create
# will return a 502 until they're set.



# ------------------------------------------------------------------------------------
CHARGILY_API_URL="https://pay.chargily.net/api/v2"
CHARGILY_SECRET_KEY="test_sk_xxxxxxxxxxxxxxxx"
CHARGILY_WEBHOOK_SECRET="whsec_chargily_xxxxxxxxxxxxxxxx"




# --- AIPeT: the AI tutor itself ---
# ------------------------------------------------------------------------------------:
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="****"




# --- AIPeT: handwriting OCR (Google Cloud Vision) ---
# Get a free API key at https://console.cloud.google.com — create/select a
# project, enable "Cloud Vision API" under APIs & Services > Library, then
# create an API key under APIs & Services > Credentials. Free tier: 1,000
# requests/month, no card required. If left blank, the exercise page falls
# back to letting the student type/paste their work instead of
# photographing it, so AIPeT still works without this configured.
# Note: general-purpose OCR, not math-specialized like Mathpix was — see
# the comment at the top of src/lib/ocr.ts for the tradeoff.
# -----------------------------------------------------------------------------------:
GOOGLE_VISION_API_KEY="******"



# --- Seeding (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@aipet.dz"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
